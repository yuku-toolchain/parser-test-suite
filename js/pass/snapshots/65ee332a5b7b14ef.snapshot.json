    {
      "type": "Block",
      "value": "---\nesid: sec-temporal.plaindatetime.prototype.add\ndescription: >\n  Check mapping of numerical months across leap years. This catches bugs in\n  implementations where numeric months are not correctly mapped across leap\n  years, allowing additions that should throw with overflow reject.\n  See https://github.com/tc39/test262/issues/4905\nfeatures: [Temporal]\n---",
      "start": 128,
      "end": 492
    },
    {
      "type": "Line",
      "value": " 5000 is a leap year, and month 6 is the leap month Adar I, inserted between",
      "start": 494,
      "end": 572
    },
    {
      "type": "Line",
      "value": " month 5 and 6 of a common year.",
      "start": 573,
      "end": 607
    }
