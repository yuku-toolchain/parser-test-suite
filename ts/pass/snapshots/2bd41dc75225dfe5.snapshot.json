      "start": 110,
      "end": 170
    },
    {
      "type": "Line",
      "value": " That means that '_this' becomes a reserved identifier in certain places.",
      "start": 172,
      "end": 247
    },
    {
      "type": "Line",
      "value": "",
      "start": 249,
      "end": 251
    },
    {
